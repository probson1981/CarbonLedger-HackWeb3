# ==============================================
# CarbonLedger - Exemplo de configuracao Sepolia
# ==============================================
# Passo a passo rapido:
# 1) Copie este arquivo para .env
# 2) Preencha os valores com os dados da sua carteira/rede
# 3) Nunca publique seu .env real no GitHub

# RPC da rede Sepolia.
# Pode usar endpoint publico ou provedor como Infura/Alchemy.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Chave privada da conta deployer (com prefixo 0x).
# Essa conta paga deploy, setup, funding e transferencia de ownership.
# Use conta de teste com pouco saldo e nunca compartilhe essa chave.
SEPOLIA_DEPLOYER_PRIVATE_KEY=0xCOLOQUE_A_PRIVATE_KEY_DO_DEPLOYER_AQUI

# API Key do Etherscan (opcional).
# So e necessaria se voce quiser verificar contratos no Etherscan.
ETHERSCAN_API_KEY=

# Enderecos publicos das contas usadas no MVP.
# Dica: gerar com o script abaixo e copiar os enderecos gerados.
# npx hardhat run .\scripts\gerar_carteiras_sepolia.ts
SEPOLIA_ADMIN_ADDRESS=0xEnderecoDoAdmin
SEPOLIA_PROPONENTE_ADDRESS=0xEnderecoDoProponente
SEPOLIA_VALIDADOR1_ADDRESS=0xEnderecoDoValidador1
SEPOLIA_VALIDADOR2_ADDRESS=0xEnderecoDoValidador2
SEPOLIA_COMPRADOR_ADDRESS=0xEnderecoDoComprador
SEPOLIA_USUARIO_EXTRA_ADDRESS=0xEnderecoUsuarioExtra

# Parametros do script de funding.
# SEPOLIA_FUND_AMOUNT_ETH: valor enviado para cada carteira no funding.
# SEPOLIA_MIN_BALANCE_ETH: saldo minimo esperado para considerar a carteira pronta.
SEPOLIA_FUND_AMOUNT_ETH=0.05
SEPOLIA_MIN_BALANCE_ETH=0.02